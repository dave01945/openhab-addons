<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="octopusapi"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="octopus">

		<label>Octopus API Binding Thing</label>
		<description>Octopus API Binding for consumption and agile rates</description>

		<channels>
			<channel id="consumption" typeId="consumption"/>
			<channel id="export" typeId="export"/>
			<channel id="currentRates" typeId="currentRates"/>
			<channel id="currentExRates" typeId="currentExRates"/>
			<channel id="gasConsumption" typeId="gasConsumption"/>
			<channel id="gasRates" typeId="gasRates"/>
			<channel id="gasExRates" typeId="gasExRates"/>
			<channel id="liveDemand" typeId="liveDemand"/>
			<channel id="liveMeterReading" typeId="liveMeterReading"/>
		</channels>

		<config-description-ref uri="thing-type:octopusapi:settings"/>
	</thing-type>

	<channel-type id="consumption">
		<item-type>Number:Energy</item-type>
		<label>Consumption</label>
		<description>30 min energy consumption</description>
		<state pattern="%.2f %unit%"></state>
	</channel-type>
	<channel-type id="export">
		<item-type>Number:Energy</item-type>
		<label>Export</label>
		<description>30 min energy export</description>
		<state pattern="%.2f %unit%"></state>
	</channel-type>
	<channel-type id="currentRates">
		<item-type>Number</item-type>
		<label>Current Tariff Rates</label>
		<description>Account tariff rates from GraphQL API (GBP per kWh)</description>
		<state pattern="%.2f"></state>
	</channel-type>
	<channel-type id="currentExRates">
		<item-type>Number</item-type>
		<label>Current Tariff Rates Excluding VAT</label>
		<description>Account tariff rates excluding VAT from GraphQL API (GBP per kWh)</description>
		<state pattern="%.2f"></state>
	</channel-type>
	<channel-type id="gasConsumption">
		<item-type>Number:Energy</item-type>
		<label>Gas Consumption</label>
		<description>30 min gas consumption</description>
		<state pattern="%.2f %unit%"></state>
	</channel-type>
	<channel-type id="gasRates">
		<item-type>Number</item-type>
		<label>Gas Tariff Rates</label>
		<description>Gas tariff rates from GraphQL API (GBP per kWh)</description>
		<state pattern="%.2f"></state>
	</channel-type>
	<channel-type id="gasExRates">
		<item-type>Number</item-type>
		<label>Gas Tariff Rates Excluding VAT</label>
		<description>Gas tariff rates excluding VAT from GraphQL API (GBP per kWh)</description>
		<state pattern="%.2f"></state>
	</channel-type>
	<channel-type id="liveDemand">
		<item-type>Number:Power</item-type>
		<label>Live Demand</label>
		<description>Real-time power demand (requires Octopus Home Mini)</description>
		<state pattern="%.0f %unit%"></state>
	</channel-type>
	<channel-type id="liveMeterReading">
		<item-type>Number:Energy</item-type>
		<label>Live Meter Reading</label>
		<description>Real-time cumulative meter reading (requires Octopus Home Mini)</description>
		<state pattern="%.3f %unit%"></state>
	</channel-type>
</thing:thing-descriptions>
