<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="octopusapi"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<thing-type id="octopus">

		<label>Octopus API Binding Thing</label>
		<description>Octopus API Binding for consumption and agile rates</description>

		<channels>
			<channel id="consumption" typeId="consumption"/>
			<channel id="export" typeId="export"/>
			<channel id="currentRates" typeId="currentRates"/>
			<channel id="currentExRates" typeId="currentExRates"/>
			<channel id="gasConsumption" typeId="gasConsumption"/>
			<channel id="gasRates" typeId="gasRates"/>
			<channel id="gasExRates" typeId="gasExRates"/>
			<channel id="liveDemand" typeId="liveDemand"/>
			<channel id="liveMeterReading" typeId="liveMeterReading"/>
			<channel id="liveExportReading" typeId="liveExportReading"/>
			<channel id="accountBalance" typeId="accountBalance"/>
			<channel id="electricityTariffName" typeId="electricityTariffName"/>
			<channel id="electricityTariffDescription" typeId="electricityTariffDescription"/>
			<channel id="electricityStandingCharge" typeId="electricityStandingCharge"/>
			<channel id="gasTariffName" typeId="gasTariffName"/>
			<channel id="gasTariffDescription" typeId="gasTariffDescription"/>
			<channel id="gasStandingCharge" typeId="gasStandingCharge"/>
			<channel id="agileRates" typeId="agileRates"/>
			<channel id="agileExRates" typeId="agileExRates"/>
		</channels>

		<config-description-ref uri="thing-type:octopusapi:settings"/>
	</thing-type>

	<channel-type id="consumption">
		<item-type>Number:Energy</item-type>
		<label>Consumption</label>
		<description>30 min energy consumption</description>
		<state pattern="%.2f %unit%"></state>
	</channel-type>
	<channel-type id="export">
		<item-type>Number:Energy</item-type>
		<label>Export</label>
		<description>30 min energy export</description>
		<state pattern="%.2f %unit%"></state>
	</channel-type>
	<channel-type id="currentRates">
		<item-type>Number</item-type>
		<label>Current Tariff Rates</label>
		<description>Account tariff rates from GraphQL API (GBP per kWh)</description>
		<state pattern="%.2f"></state>
	</channel-type>
	<channel-type id="currentExRates">
		<item-type>Number</item-type>
		<label>Current Tariff Rates Excluding VAT</label>
		<description>Account tariff rates excluding VAT from GraphQL API (GBP per kWh)</description>
		<state pattern="%.2f"></state>
	</channel-type>
	<channel-type id="gasConsumption">
		<item-type>Number:Energy</item-type>
		<label>Gas Consumption</label>
		<description>30 min gas consumption</description>
		<state pattern="%.2f %unit%"></state>
	</channel-type>
	<channel-type id="gasRates">
		<item-type>Number</item-type>
		<label>Gas Tariff Rates</label>
		<description>Gas tariff rates from GraphQL API (GBP per kWh)</description>
		<state pattern="%.2f"></state>
	</channel-type>
	<channel-type id="gasExRates">
		<item-type>Number</item-type>
		<label>Gas Tariff Rates Excluding VAT</label>
		<description>Gas tariff rates excluding VAT from GraphQL API (GBP per kWh)</description>
		<state pattern="%.2f"></state>
	</channel-type>
	<channel-type id="liveDemand">
		<item-type>Number:Power</item-type>
		<label>Live Demand</label>
		<description>Real-time power demand (requires Octopus Home Mini)</description>
		<state pattern="%.0f %unit%"></state>
	</channel-type>
	<channel-type id="liveMeterReading">
		<item-type>Number:Energy</item-type>
		<label>Live Meter Reading</label>
		<description>Real-time cumulative meter reading (requires Octopus Home Mini)</description>
		<state pattern="%.3f %unit%"></state>
	</channel-type>
	<channel-type id="liveExportReading">
		<item-type>Number:Energy</item-type>
		<label>Live Export Reading</label>
		<description>Real-time cumulative export meter reading (requires Octopus Home Mini)</description>
		<state pattern="%.3f %unit%"></state>
	</channel-type>
	<channel-type id="accountBalance">
		<item-type>Number</item-type>
		<label>Account Balance</label>
		<description>Current account balance in GBP (negative = credit)</description>
		<state pattern="£%.2f" readOnly="true"></state>
	</channel-type>
	<channel-type id="electricityTariffName">
		<item-type>String</item-type>
		<label>Electricity Tariff Name</label>
		<description>Current electricity tariff display name</description>
		<state readOnly="true"></state>
	</channel-type>
	<channel-type id="electricityTariffDescription">
		<item-type>String</item-type>
		<label>Electricity Tariff Description</label>
		<description>Current electricity tariff description</description>
		<state readOnly="true"></state>
	</channel-type>
	<channel-type id="electricityStandingCharge">
		<item-type>Number</item-type>
		<label>Electricity Standing Charge</label>
		<description>Daily electricity standing charge in GBP</description>
		<state pattern="£%.2f" readOnly="true"></state>
	</channel-type>
	<channel-type id="gasTariffName">
		<item-type>String</item-type>
		<label>Gas Tariff Name</label>
		<description>Current gas tariff display name</description>
		<state readOnly="true"></state>
	</channel-type>
	<channel-type id="gasTariffDescription">
		<item-type>String</item-type>
		<label>Gas Tariff Description</label>
		<description>Current gas tariff description</description>
		<state readOnly="true"></state>
	</channel-type>
	<channel-type id="gasStandingCharge">
		<item-type>Number</item-type>
		<label>Gas Standing Charge</label>
		<description>Daily gas standing charge in GBP</description>
		<state pattern="£%.2f" readOnly="true"></state>
	</channel-type>
	<channel-type id="agileRates">
		<item-type>Number</item-type>
		<label>Agile Tariff Rates</label>
		<description>Next 24h Agile tariff rates inc. VAT (GBP per kWh)</description>
		<state pattern="%.4f"></state>
	</channel-type>
	<channel-type id="agileExRates">
		<item-type>Number</item-type>
		<label>Agile Tariff Rates Excl. VAT</label>
		<description>Next 24h Agile tariff rates exc. VAT (GBP per kWh)</description>
		<state pattern="%.4f"></state>
	</channel-type>
</thing:thing-descriptions>
